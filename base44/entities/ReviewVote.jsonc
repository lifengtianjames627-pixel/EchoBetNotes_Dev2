{
  "name": "ReviewVote",
  "type": "object",
  "properties": {
    "review_id": {
      "type": "string",
      "description": "ID of the review being voted on"
    },
    "voter_email": {
      "type": "string",
      "description": "Legacy voter identity, bound to the authenticated user by voteReview"
    },
    "vote": {
      "type": "string",
      "enum": [
        "like",
        "dislike"
      ],
      "description": "Vote type"
    }
  },
  "required": [
    "review_id",
    "voter_email",
    "vote"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.voter_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}