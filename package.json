{
  "name": "echoes-between-notes",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "check": "node server/check.js",
    "build:server": "node server/check.js",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test server/tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 server/tests/integration/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@eslint/js": "^9.19.0",
    "eslint": "^9.20.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0"
  }
}
