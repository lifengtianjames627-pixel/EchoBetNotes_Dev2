# Frontend (Vite) — copy to .env.local for local development
VITE_APP_ID=echoes-between-notes
VITE_API_BASE_URL=
VITE_LOGIN_URL=/login

# Backend — copy to .env or .env.local (loaded by Node when present)
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgres://echoes:echoes@localhost:5432/echoes
DATABASE_SSL=false

JWT_SECRET=development-only-change-this-secret-32
JWT_ISSUER=echoes-between-notes
ACCESS_TOKEN_TTL=2h
SESSION_DAYS=30

PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
ALLOW_REGISTRATION=true
BOOTSTRAP_ADMIN_EMAIL=

STORAGE_DRIVER=local
UPLOAD_DIRECTORY=var/uploads

# S3-compatible storage (production media)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional OpenAI-compatible moderation endpoint
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
